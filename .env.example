GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_SERVER_PORT=8787
CORS_ORIGIN=http://localhost:8080

# Optional frontend override. Keep default when using Vite proxy.
# VITE_AI_CHAT_API_URL=/api/ai-chat

# Kunphen FastAPI backend (public APIs for Medicines, Articles, Gallery)
VITE_API_BASE_URL=http://localhost:8000

# Google Analytics 4 measurement id (G-XXXXXXXXXX).
# Leave empty locally so dev traffic never reaches the production property.
VITE_GA_MEASUREMENT_ID=
